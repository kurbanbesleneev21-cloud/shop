# PostgreSQL (Neon / Supabase / любой Postgres)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Прямое (не pooled) подключение для prisma db push
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Секрет для подписи сессий и шифрования секретных настроек (минимум 32 символа)
AUTH_SECRET="..."
# Первый администратор (создаётся при сиде)
ADMIN_EMAIL="admin@techmarket.ru"
ADMIN_PASSWORD="..."
# Vercel Blob (подставляется автоматически при подключении Blob Store)
BLOB_READ_WRITE_TOKEN=""
